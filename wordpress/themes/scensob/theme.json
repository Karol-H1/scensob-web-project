{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1120px",
			"wideSize": "1240px"
		},
		"color": {
			"custom": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "color": "#FFFFFF", "name": "Base" },
				{ "slug": "surface", "color": "#FFFFFF", "name": "Surface" },
				{ "slug": "contrast", "color": "#33302B", "name": "Ink" },
				{ "slug": "muted", "color": "#7A7168", "name": "Muted" },
				{ "slug": "line", "color": "#E7E2DA", "name": "Line" },
				{ "slug": "line-strong", "color": "#D3CCC0", "name": "Line strong" },
				{ "slug": "accent", "color": "#B8823F", "name": "Accent" },
				{ "slug": "accent-soft", "color": "#F7F1E8", "name": "Accent soft" },
				{ "slug": "accent-contrast", "color": "#FFFFFF", "name": "Accent contrast" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "ui-sans-serif, \"Segoe UI\", system-ui, -apple-system, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "ui-serif, Georgia, \"Times New Roman\", serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "14px", "name": "Small" },
				{ "slug": "medium", "size": "16px", "name": "Medium" },
				{ "slug": "large", "size": "18px", "name": "Large" },
				{
					"slug": "x-large",
					"size": "32px",
					"name": "Extra large",
					"fluid": { "min": "26px", "max": "32px" }
				},
				{
					"slug": "xx-large",
					"size": "54px",
					"name": "Display",
					"fluid": { "min": "34px", "max": "54px" }
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{ "slug": "20", "size": "10px", "name": "1" },
				{ "slug": "30", "size": "20px", "name": "2" },
				{ "slug": "40", "size": "28px", "name": "3" },
				{ "slug": "50", "size": "40px", "name": "4" },
				{ "slug": "60", "size": "64px", "name": "5" },
				{ "slug": "70", "size": "88px", "name": "6" }
			]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"shadow": { "defaultPresets": false }
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			},
			"blockGap": "var:preset|spacing|30"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "1.08"
				}
			},
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "700"
				}
			},
			"link": {
				"color": { "text": "var:preset|color|accent" },
				"typography": { "textDecoration": "none" },
				":hover": { "typography": { "textDecoration": "underline" } }
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|accent-contrast"
				},
				"border": { "radius": "8px" },
				"spacing": {
					"padding": {
						"top": "11px",
						"bottom": "11px",
						"left": "22px",
						"right": "22px"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "700"
				},
				":hover": { "color": { "background": "var:preset|color|contrast" } }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "600"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|muted" },
						":hover": { "color": { "text": "var:preset|color|contrast" } }
					}
				}
			},
			"core/separator": { "color": { "text": "var:preset|color|line" } },
			"core/post-title": {
				"typography": { "fontSize": "var:preset|font-size|xx-large" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Page (full width)",
			"postTypes": ["page"]
		}
	]
}
